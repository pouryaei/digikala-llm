  "dataset_scope": "Forouhar 100000 products / 1874457 reviews",
  "design": {
    "qa": "Complete review-level relevance judgments for every review of 14 selected real products. Question and qrels authored before any evaluation-run ranking; grades 2/1/0. Assistant-assisted reference annotation, not independent human labels.",
    "split": "Product-disjoint QA dev/holdout; search dev and holdout have different intents/examples; fixed before improvement.",
    "search": "Independent catalogue conditions (title/category/brand/recorded price), not ranking scores. They are a conservative relevance proxy.",
    "grade_2": "explicitly answers at least one requested facet or reports a directly relevant experience",
    "grade_1": "indirectly relevant context (related facet, generic sentiment or label where appropriate)",
    "grade_0": "unrelated or no evidence on the requested facet",
    "caveat": "Small purposefully diverse suite, not a random estimate for the full store. No live LLM-as-judge."
  },
