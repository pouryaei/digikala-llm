QBC13_API_KEY=
# Direct tabs stay local; paid calls require per-request Professional consent.
QBC13_REVIEW_GENERATION_MODE=extractive
QBC13_LLM_MODEL=openai/gpt-4o-mini
QBC13_API_BASE_URL=https://193.93.169.12/v1
# Set rial or toman only if the original Price unit is confirmed; otherwise leave blank.
QBC13_SOURCE_PRICE_UNIT=

# Optional external observability (off by default; local monitor needs no keys).
FOROUHAR_LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=forouhar
# Actual gateway tariffs, USD per million tokens (leave blank if unknown).
FOROUHAR_INPUT_USD_PER_MILLION=
FOROUHAR_OUTPUT_USD_PER_MILLION=


# Configurable candidate chat models, not benchmark winners.
QBC13_ROUTER_MODEL=google/gemini-2.5-flash-lite
QBC13_QA_MODEL=openai/gpt-4o-mini
QBC13_COMPARE_MODEL=openai/gpt-4.1-mini
QBC13_MANAGER_MODEL=openai/gpt-4.1-mini
QBC13_PRO_MAX_ATTEMPTS=2
# Actual gateway USD per million tokens for each model. Leave empty until verified.
QBC13_MODEL_TARIFFS_JSON={}
